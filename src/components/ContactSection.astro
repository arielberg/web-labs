---
interface Props {
  defaultType?: 'direct' | 'partner' | 'sprint' | 'other';
  headingLevel?: 'h1' | 'h2';
}

const { defaultType, headingLevel = 'h2' } = Astro.props;
const Heading = headingLevel;
---

<section class="band contact-band" id="contact" aria-labelledby="contact-heading">
  <div class="band__inner band__inner--narrow">
    <header class="section-head">
      <Heading class="section-head__title" id="contact-heading" data-i18n="contact.title">
        יש פרויקט שדורש חשיבה טכנולוגית בכירה?
      </Heading>
      <p data-i18n="contact.lead">
        כתבו בקצרה מה המערכת, מה האתגר ובאיזה שלב נמצא הפרויקט. נחזור לשיחת התאמה ממוקדת.
      </p>
    </header>

    <form class="contact-form" id="contactForm" data-default-type={defaultType || ''} novalidate>
      <div class="contact-form__grid">
        <label for="contactName">
          <span data-i18n="contact.name">שם</span>
          <input id="contactName" name="name" type="text" required autocomplete="name" />
        </label>
        <label for="contactCompany">
          <span data-i18n="contact.company">חברה</span>
          <input id="contactCompany" name="company" type="text" autocomplete="organization" />
        </label>
      </div>
      <label for="contactReach">
        <span data-i18n="contact.reach">טלפון או דוא״ל</span>
        <input
          id="contactReach"
          name="reach"
          type="text"
          required
          autocomplete="email"
          inputmode="email"
        />
      </label>
      <label for="contactType">
        <span data-i18n="contact.type">סוג הפנייה</span>
        <select id="contactType" name="type" required>
          <option value="" disabled selected data-i18n="contact.typePlaceholder">בחרו סוג פנייה</option>
          <option value="direct" data-i18n="contact.typeDirect">פרויקט ישיר</option>
          <option value="partner" data-i18n="contact.typePartner">שיתוף פעולה עם ספק טכנולוגי</option>
          <option value="sprint" data-i18n="contact.typeSprint">ספרינט ארכיטקטורה</option>
          <option value="other" data-i18n="contact.typeOther">אחר</option>
        </select>
      </label>
      <label for="contactChallenge">
        <span data-i18n="contact.challenge">תיאור קצר של האתגר</span>
        <textarea id="contactChallenge" name="challenge" rows="4" required></textarea>
      </label>
      <div class="hp" aria-hidden="true">
        <label for="contactWebsite">Website</label>
        <input id="contactWebsite" name="website" type="text" tabindex="-1" autocomplete="off" />
      </div>
      <button type="submit" class="btn btn--primary btn--block" data-i18n="contact.submit">
        שליחת הפנייה
      </button>
      <p class="form-note" id="contactNote" role="status" aria-live="polite"></p>
    </form>

    <div class="contact__rows">
      <a href="mailto:info@web-labs.com">info@web-labs.com</a>
      <a href="tel:+972772200005">077-2200005</a>
    </div>
  </div>
</section>
