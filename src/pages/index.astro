---
import BaseLayout from '../layouts/BaseLayout.astro';
import CommsHero from '../components/CommsHero.astro';
import ContactSection from '../components/ContactSection.astro';
import LogoAnimated from '../components/LogoAnimated.astro';
import { getCollection } from 'astro:content';

const articles = (await getCollection('articles'))
  .filter((a) => !a.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const formatDate = (d: Date) =>
  d.toLocaleDateString('he-IL', { year: 'numeric', month: 'short', day: 'numeric' });

const services = [
  {
    titleKey: 'svc.partners.title',
    title: 'שותפות טכנולוגית לספקים',
    leadKey: 'svc.partners.lead',
    lead: 'חיזוק צוותי פיתוח ואינטגרציה בפרויקטים הדורשים ארכיטקטורה, Salesforce, אבטחה או חיבור מערכות מורכב.',
    items: [
      ['svc.partners.i1', 'תכנון פתרון והערכת מאמץ'],
      ['svc.partners.i2', 'ליווי צוותי פיתוח'],
      ['svc.partners.i3', 'ביקורת ארכיטקטורה'],
      ['svc.partners.i4', 'פתרון נקודות תקועות'],
      ['svc.partners.i5', 'השתלבות בפרויקט כקבלן משנה'],
    ],
  },
  {
    titleKey: 'svc.sf.title',
    title: 'Salesforce ואינטגרציות',
    leadKey: 'svc.sf.lead',
    lead: 'תכנון ויישום של פתרונות Salesforce המחוברים למערכות ולתהליכים הארגוניים.',
    items: [
      ['svc.sf.i1', 'APIs ואינטגרציות'],
      ['svc.sf.i2', 'Identity, SSO ו-MFA'],
      ['svc.sf.i3', 'הרשאות ואבטחה'],
      ['svc.sf.i4', 'תכנון נתונים ותהליכים'],
      ['svc.sf.i5', 'ביצועים, DevOps וייצוב מערכות'],
    ],
  },
  {
    titleKey: 'svc.ai.title',
    title: 'AI המחובר לארגון',
    leadKey: 'svc.ai.lead',
    lead: 'מעבר מאב־טיפוס של AI למערכת מאובטחת, מבוקרת ושימושית המחוברת לסביבה הארגונית.',
    items: [
      ['svc.ai.i1', 'סוכנים המחוברים ל-CRM ולמערכות מידע'],
      ['svc.ai.i2', 'חיפוש וידע ארגוני'],
      ['svc.ai.i3', 'אוטומציה של שירות ותפעול'],
      ['svc.ai.i4', 'הרשאות, Audit ו-Governance'],
      ['svc.ai.i5', 'סוכני קול כחלק מתהליך עסקי'],
    ],
  },
];

const whenItems = [
  ['when.i1', 'כשהפרויקט מורכב ודרוש ידע מתקדם בארכיטקטורה.'],
  ['when.i2', 'אינטגרציה בין מערכות נתקעה או נעשתה קשה לתחזוקה.'],
  ['when.i3', 'רוצים להוסיף AI למערכת קיימת בלי להחליף את התשתית.'],
  ['when.i4', 'אב־טיפוס של AI צריך להפוך לפתרון מאובטח ויציב.'],
  ['when.i5', 'נדרשת בדיקה מקצועית לפני פיתוח, הצעת מחיר או עלייה לייצור.'],
];

const sprintItems = [
  ['sprint.i1', 'מסמך ארכיטקטורה'],
  ['sprint.i2', 'גבולות הפרויקט'],
  ['sprint.i3', 'סיכונים והחלטות מרכזיות'],
  ['sprint.i4', 'הערכת שלבים ומאמץ'],
  ['sprint.i5', 'תוכנית יישום מעשית'],
];

const capabilities = [
  'Enterprise Architecture',
  'Salesforce',
  'API & Integrations',
  'Security & Identity',
  'AWS & Cloud',
  'AI Agents',
  'Voice AI',
  'DevOps',
];
---

<BaseLayout
  title="Web Labs — ארכיטקטורה, Salesforce, אינטגרציות ו-AI"
  description="ארכיטקטורה וביצוע לפרויקטים מורכבים של Salesforce, אינטגרציות וסוכני AI עבור חברות טכנולוגיה וארגונים פרטיים."
  canonicalPath="/"
  home
>
  <main id="top">
    <section class="hero hero--offer">
      <div class="hero__glow" aria-hidden="true"></div>
      <div class="hero__inner">
        <div class="logo logo--hero" aria-label="Web Labs">
          <LogoAnimated uid="hero" variant="hero" />
        </div>
        <h1 data-i18n="hero.title">ארכיטקטורה וביצוע לפרויקטים מורכבים</h1>
        <p class="hero__sub" data-i18n="hero.sub">
          Salesforce, אינטגרציות וסוכני AI המחוברים למערכות ארגוניות — משלב התכנון ועד מערכת עובדת.
        </p>
        <p class="hero__audience" data-i18n="hero.audience">
          עבור בתי תוכנה, חברות אינטגרציה וארגונים פרטיים הזקוקים ליכולת טכנולוגית בכירה.
        </p>
        <div class="hero__actions">
          <a class="btn btn--primary" href="#contact" data-inquiry="direct" data-i18n="hero.ctaPrimary">
            נדבר על הפרויקט
          </a>
          <a
            class="btn btn--secondary"
            href="/technology-partners/?type=partner#contact"
            data-inquiry="partner"
            data-i18n="hero.ctaSecondary"
          >
            צריכים ארכיטקט לפרויקט פעיל?
          </a>
        </div>
      </div>
    </section>

    <div class="site-content">
      <section class="band" id="services" aria-labelledby="services-heading">
        <div class="band__inner">
          <header class="section-head">
            <h2 class="section-head__title" id="services-heading" data-i18n="svc.title">שירותים</h2>
          </header>
          <div class="service-grid">
            {
              services.map((service) => (
                <article class="service-card">
                  <h3 data-i18n={service.titleKey}>{service.title}</h3>
                  <p data-i18n={service.leadKey}>{service.lead}</p>
                  <ul>
                    {service.items.map(([key, text]) => (
                      <li data-i18n={key}>{text}</li>
                    ))}
                  </ul>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <section class="band" id="when" aria-labelledby="when-heading">
        <div class="band__inner band__inner--narrow">
          <header class="section-head">
            <h2 class="section-head__title" id="when-heading" data-i18n="when.title">
              מתי Web Labs יכולה לעזור?
            </h2>
          </header>
          <ul class="plain-list">
            {
              whenItems.map(([key, text]) => (
                <li data-i18n={key}>{text}</li>
              ))
            }
          </ul>
        </div>
      </section>

      <section class="band" id="sprint" aria-labelledby="sprint-heading">
        <div class="band__inner">
          <article class="sprint-card">
            <header class="section-head">
              <h2 class="section-head__title" id="sprint-heading" data-i18n="sprint.title">
                ספרינט ארכיטקטורה
              </h2>
              <p data-i18n="sprint.lead">
                תהליך ממוקד להגדרת הפתרון, המערכות, האינטגרציות, ההרשאות ותוכנית הביצוע.
              </p>
            </header>
            <ul class="plain-list plain-list--tight">
              {
                sprintItems.map(([key, text]) => (
                  <li data-i18n={key}>{text}</li>
                ))
              }
            </ul>
            <a class="btn btn--primary" href="#contact" data-inquiry="sprint" data-i18n="sprint.cta">
              בדיקת התאמה לספרינט
            </a>
          </article>
        </div>
      </section>

      <section class="band" id="experience" aria-labelledby="experience-heading">
        <div class="band__inner">
          <header class="section-head">
            <h2 class="section-head__title" id="experience-heading" data-i18n="exp.title">
              ניסיון שמחבר בין ארכיטקטורה לביצוע
            </h2>
            <p data-i18n="exp.lead">
              ניסיון מעשי בתכנון ופיתוח של מערכות Enterprise, Salesforce, AWS, APIs, אבטחה, Identity וסוכני AI. העבודה משלבת ראייה מערכתית עם יכולת לרדת לפרטי היישום, הקוד וההטמעה.
            </p>
          </header>
          <ul class="capability-tags">
            {
              capabilities.map((cap) => (
                <li>
                  <span class="tag">{cap}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <section class="band agent-demo" id="agent-demo" aria-labelledby="demo-heading">
        <div class="band__inner">
          <header class="section-head section-head--center">
            <h2 class="section-head__title" id="demo-heading" data-i18n="demo.title">
              רוצים לראות סוכן בפעולה?
            </h2>
            <p data-i18n="demo.lead">
              הצ׳אט וסוכן הטלפון באתר פועלים על תשתית הסוכנים של Web Labs. אפשר לדבר איתם, להשאיר פרטים או לבקש שיחה.
            </p>
          </header>
          <div class="agent-demo__stage">
            <CommsHero />
            <p class="talk-status" id="talkHint" hidden></p>
            <audio id="remoteAudio" autoplay playsinline></audio>
          </div>
        </div>
      </section>

      {
        articles.length > 0 && (
          <section class="band teasers teasers--band" aria-labelledby="articles-heading">
            <div class="band__inner">
              <div class="teasers__head">
                <h2 class="teasers__title" id="articles-heading" data-i18n="articles.teaserTitle">
                  ידע מעשי על מערכות ו-AI ארגוני
                </h2>
                <a class="teasers__more" href="/articles/" data-i18n="articles.more">הכל</a>
              </div>
              <ul class="teasers__list teasers__list--single">
                {articles.map((article) => (
                  <li>
                    <a class="teaser-row" href={`/articles/${article.id}/`}>
                      <time datetime={article.data.date.toISOString()}>{formatDate(article.data.date)}</time>
                      <span class="teaser-row__title">{article.data.title}</span>
                      <span class="teaser-row__excerpt">{article.data.description}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </section>
        )
      }

      <ContactSection />
    </div>
  </main>
</BaseLayout>
